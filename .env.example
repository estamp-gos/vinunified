# SMTP - copy this file to .env on the live server and fill in the
# real values there. Do NOT commit .env itself to Git (.gitignore
# already excludes it); only this example file is safe to commit.
# For Google SMTP: host smtp.gmail.com, port 465, encryption ssl,
# username = the Gmail address, password = a Gmail app password,
# From = the same Gmail address.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM=
MAIL_FROM_NAME=VinUnified
